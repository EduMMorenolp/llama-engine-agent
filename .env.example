# ==============================================================================
# llama-engine-agent — Variables de Entorno
# Conectado a runtime llama-engine (http://localhost:3050)
# ==============================================================================

# PostgreSQL del Agente (engine-postgres)
POSTGRES_PORT=5434
POSTGRES_DB=agent_db
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_secret_password

# Faster-Whisper Local con CUDA (engine-whisper)
WHISPER_PORT=8000
WHISPER_GPU_DEVICE=all
WHISPER_MODEL=Systran/faster-whisper-small

# n8n Orquestador (engine-n8n)
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678
TIMEZONE=America/Argentina/Buenos_Aires

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agente API y Web UI (engine-agent)
AGENT_API_PORT=3060
AGENT_UI_PORT=3061

# Conexión con llama-engine (Inferencia LLM)
LLAMA_API_URL=http://localhost:3050/v1

